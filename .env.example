PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ug_alumnisphere_db
MONGODB_DB_NAME=ug_alumnisphere_db

# Required for authentication. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000

# Supabase is used for file storage only. Application data stays in MongoDB.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
